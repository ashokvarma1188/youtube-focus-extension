{
  "manifest_version": 3,
  "name": "YouTube Focus Mode",
  "version": "1.0",

  "permissions": ["storage", "tabs", "notifications"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}